<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/c_log_bg"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/log_title"
        android:textColor="@color/c_log_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="4dp" />

    <!-- Поле email для отправки лога -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textColor="@color/c_log_text"
            android:textSize="14sp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/logEmailInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textEmailAddress"
            android:textColor="@color/c_log_text"
            android:textSize="14sp"
            android:background="@android:drawable/editbox_background"
            android:padding="6dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Кнопки: ОЧИСТИТЬ, ПОДЕЛИТЬСЯ, ОТПРАВИТЬ НА EMAIL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_clear"
            android:textSize="12sp"
            android:backgroundTint="@color/c_red"
            android:textColor="@color/c_white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_share"
            android:textSize="12sp"
            android:backgroundTint="@color/c_blue"
            android:textColor="@color/c_white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSendEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMAIL"
            android:textSize="12sp"
            android:backgroundTint="@color/c_green"
            android:textColor="@color/c_white" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@color/c_black">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textColor="@color/c_log_text"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>