<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/c_blue" />

        <!-- ======================= VOX ======================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="VOX — автоматическая передача"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voxStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="СОСТОЯНИЕ: ГОТОВ"
            android:textSize="16sp"
            android:textColor="@color/c_black" />

        <!-- Индикатор PTT -->
        <TextView
            android:id="@+id/pttStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PTT: ВЫКЛ"
            android:textSize="16sp"
            android:textColor="@color/c_black" />

        <!-- Строка: VOX=N  MAX=N  RX=N -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/voxLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOX=0"
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <TextView
                android:id="@+id/maxLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MAX=0"
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <TextView
                android:id="@+id/rxLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RX=0"
                android:textSize="16sp"
                android:textColor="@color/c_black" />
        </LinearLayout>

        <!-- Строка My_Vox=N с кнопкой МАРКЕР справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/myVoxText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My_Vox=400"
                android:textSize="18sp"
                android:textColor="@color/c_black" />

            <Button
                android:id="@+id/btnLockVox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_marker"
                android:textSize="12sp"
                android:minWidth="80dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/c_gray" />
        </LinearLayout>

        <com.pmr.admin.VoxView
            android:id="@+id/voxView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:text="vox_pause (тики)  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <EditText
                android:id="@+id/voxPauseInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:text="vox_mic  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <EditText
                android:id="@+id/voxMicInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:text="PoslePrd (тики)  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <EditText
                android:id="@+id/poslePrdInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ==================== PTT tone ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PTT (тон 1000 Гц на левом канале)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:text="ptt_tone_level (%)  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />

            <EditText
                android:id="@+id/pttToneLevelInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ==================== Регистрационные ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Регистрационные данные"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="Priznak_pmr  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPriznak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="MyMailIndex  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regMailIndex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="MyPChannel   ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPChannel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="ip_server  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regIpServer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="port_prm  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPortPrm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="port_prd  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regPortPrd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="onUsilMic  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/etOnUsilMic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="MicUsildouble  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/etMicUsil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="onUsilDin  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/etOnUsilDin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="DinUsildouble  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/etDinUsil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="Call  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regCallsign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="QTH  ="
                android:textSize="16sp"
                android:textColor="@color/c_black" />
            <EditText android:id="@+id/regCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- =================== Смена пароля =================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Смена пароля"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/requirePassBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_password_title"
            android:textSize="16sp"
            android:checked="true" />

        <EditText android:id="@+id/passCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_current_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <EditText android:id="@+id/passNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_new_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <EditText android:id="@+id/passConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_confirm_pass"
            android:inputType="textPassword"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_save"
            android:backgroundTint="@color/c_green"
            android:textColor="@color/c_white"
            android:textSize="18sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/btnOpenLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_log_open"
            android:backgroundTint="@color/c_blue"
            android:textColor="@color/c_white"
            android:textSize="16sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

    </LinearLayout>
</ScrollView>