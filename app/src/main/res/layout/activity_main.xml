<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/c_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/c_blue"
        android:textSize="32sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/btn_settings"
        android:backgroundTint="@color/c_green"
        android:textColor="@color/c_white"
        android:textSize="22sp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btnUpdateCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_update_check"
        android:backgroundTint="@color/c_yellow"
        android:textColor="@color/c_black"
        android:textSize="22sp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btnCommutation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_commutation"
        android:backgroundTint="@color/c_orange"
        android:textColor="@color/c_white"
        android:textSize="22sp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp" />

</LinearLayout>